# ---- Which network the app and Hardhat deploys target ----
# "testnet" (default if unset) or "mainnet". packages/shared/src/chain.ts
# getActiveArcNetwork() reads this; Hardhat network selection is separate
# (pass --network arcTestnet / arcMainnet explicitly on each deploy command).
ARC_NETWORK=testnet

# ---- Arc Testnet (verified 2026-07-14 against docs.arc.io) ----
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_CHAIN_ID=5042002
# Testnet-only key used by Hardhat to deploy contracts. Never use a mainnet key here.
ARC_TESTNET_DEPLOYER_PRIVATE_KEY=

# ---- Arc Mainnet (verified 2026-09-22 against docs.arc.io; re-check before
# relying on it, per the caveats in packages/shared/src/chain.ts) ----
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_MAINNET_CHAIN_ID=5042
# Real funds. Needs actual USDC on Arc Mainnet for gas before it can deploy
# or transact anything -- see the Arc Microgrants page's own note that you
# need "a small amount of USDC on Arc to deploy and transact." Source that
# yourself; never paste a real private key anywhere this repo's tooling
# doesn't explicitly ask for it as a local, gitignored env var.
ARC_MAINNET_DEPLOYER_PRIVATE_KEY=

# ---- Circle Developer Platform ----
# console.circle.com -> create an API key + register an entity secret
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# ---- Supabase (persistence for obligations, decisions, wallets) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public HTTPS endpoint Circle posts webhook events to (ngrok tunnel in local dev)
WEBHOOK_ENDPOINT_URL=

# ---- StableFX ----
# Gated/RFQ product — requires requesting access from a Circle rep, no self-serve
# signup as of 2026-07-14. Leave blank until access is granted; the FX adapter
# interface in packages/shared is designed to be swapped in once credentials exist.
STABLEFX_API_KEY=

# ---- Agent wallets (generated via `npm run setup:wallet`, do not hand-edit) ----
TREASURY_WALLET_ID=
TREASURY_WALLET_ADDRESS=

# ---- Mandate escrow contract (REQUIRED — this is the live settlement path) ----
# The general, open settlement primitive: anyone can fund a mandate for
# anyone (or leave it open), a fulfiller posts proof, the funder releases
# atomically (optionally split across destinations), and outcomes update an
# on-chain reputation ledger. evaluatePendingObligations() settles every
# pay_now obligation by creating and releasing a mandate here (see
# settleObligationViaMandate in packages/shared/src/mandate.ts) — required
# for the agent to settle anything at all. Deployed via
# `npm run deploy:mandate-escrow -w packages/contracts` (or
# `deploy:mandate-escrow:mainnet`). No owner/treasury wallet coupling --
# same address works for every funder/fulfiller.
MANDATE_ESCROW_ADDRESS=

# ---- Obligation escrow contract (legacy rail, not required) ----
# The original pre-funded-pool contract the agent settled through before
# MandateEscrow above. Still real and deployable, and the dashboard's
# "Top up escrow" button still deposits into it, but evaluatePendingObligations()
# no longer calls it. Deployed via `npm run deploy:obligation-escrow -w
# packages/contracts` (or `deploy:obligation-escrow:mainnet` — see the
# --parameters example in ignition/modules/ObligationEscrow.ts). Leave unset
# to just hide the legacy balance panel/button on the dashboard.
OBLIGATION_ESCROW_ADDRESS=

# ---- Mandate demo (scripts/mandate-demo.ts) ----
# Two throwaway EOAs used only to prove the createMandate -> submitProof ->
# release cycle end to end, the same way the deck's Proof slide captured
# real ObligationEscrow tx hashes once. Not Circle-custodied -- MandateEscrow
# is permissionless, so any two funded EOAs can play funder/fulfiller.
# Each needs a little native USDC for gas; the funder also needs the demo
# amount itself. Never reuse a key that holds anything you care about.
MANDATE_DEMO_FUNDER_PRIVATE_KEY=
MANDATE_DEMO_FULFILLER_PRIVATE_KEY=

# ---- Agent decision policy ----
# Floor the agent will not pay below, regardless of due date.
TREASURY_RESERVE_USDC=500
# How many days ahead of the due date the agent is willing to settle early.
AGENT_PAY_AHEAD_WINDOW_DAYS=3

# ---- Nanopayments (x402 rate-oracle consultation, apps/oracle) ----
ORACLE_PORT=4000
# Address that receives the agent's per-request nanopayment. No private key
# needed — Circle Gateway settles directly to this address.
ORACLE_SELLER_ADDRESS=
ORACLE_URL=http://localhost:4000/rate
# Throwaway EOA the agent pays FROM — Circle Gateway payments sign directly
# via viem, so this can't go through the Circle-custodied treasury wallet.
# Needs native gas + USDC on Arc Testnet, plus a one-time Gateway deposit
# (see scripts/deposit-gateway.ts).
AGENT_X402_PRIVATE_KEY=

# ---- Cross-chain liquidity top-up (generated via `npm run setup:liquidity-wallet`) ----
# Circle-custodied wallet on Base Sepolia. When the treasury's Arc balance
# would breach TREASURY_RESERVE_USDC, the agent bridges USDC from here into
# the treasury via CCTP (Bridge Kit) before settling. Leave unset to fall
# back to the old flag-only behavior (request_liquidity is recorded but not
# acted on).
LIQUIDITY_WALLET_ID=
LIQUIDITY_WALLET_ADDRESS=

# ---- Vercel Cron (apps/web/api/cron/evaluate) ----
# Vercel sends `Authorization: Bearer $CRON_SECRET` automatically once this is
# set as a project env var; the route rejects any request that doesn't match.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
